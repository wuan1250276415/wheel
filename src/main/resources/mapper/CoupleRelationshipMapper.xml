<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basebackend.wheel.mapper.CoupleRelationshipMapper">
  <resultMap id="BaseResultMap" type="com.basebackend.wheel.entity.CoupleRelationship">
    <!--@mbg.generated-->
    <!--@Table wheel_api.couple_relationship-->
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="user_id_1" jdbcType="BIGINT" property="userId1" />
    <result column="user_id_2" jdbcType="BIGINT" property="userId2" />
    <result column="status" jdbcType="BOOLEAN" property="status" />
    <result column="invite_code" jdbcType="VARCHAR" property="inviteCode" />
    <result column="confirmed_at" jdbcType="TIMESTAMP" property="confirmedAt" />
    <result column="unbound_at" jdbcType="TIMESTAMP" property="unboundAt" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
    <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
    <result column="create_by" jdbcType="BIGINT" property="createBy" />
    <result column="update_by" jdbcType="BIGINT" property="updateBy" />
    <result column="deleted" jdbcType="BOOLEAN" property="deleted" />
  </resultMap>
  <sql id="Base_Column_List">
    <!--@mbg.generated-->
    id, user_id_1, user_id_2, `status`, invite_code, confirmed_at, unbound_at, create_time, 
    update_time, create_by, update_by, deleted
  </sql>

    <!-- 根据用户ID查询情侣关系 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM couple_relationship
        WHERE (user_id_1 = #{userId,jdbcType=BIGINT} OR user_id_2 = #{userId,jdbcType=BIGINT})
        AND status != 2
    </select>

    <!-- 根据双方用户ID查询关系 -->
    <select id="selectByUserIds" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM couple_relationship
        WHERE (
            (user_id_1 = #{userId1,jdbcType=BIGINT} AND user_id_2 = #{userId2,jdbcType=BIGINT})
            OR
            (user_id_1 = #{userId2,jdbcType=BIGINT} AND user_id_2 = #{userId1,jdbcType=BIGINT})
        )
        AND status != 2
    </select>

    <!-- 根据邀请码查询关系 -->
    <select id="selectByInviteCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM couple_relationship
        WHERE invite_code = #{inviteCode,jdbcType=VARCHAR}
        AND status != 2
    </select>

    <!-- 查询已确认的关系 -->
    <select id="selectConfirmedByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM couple_relationship
        WHERE (user_id_1 = #{userId,jdbcType=BIGINT} OR user_id_2 = #{userId,jdbcType=BIGINT})
        AND status = 1
    </select>
</mapper>