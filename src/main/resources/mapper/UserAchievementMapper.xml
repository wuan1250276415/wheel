<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basebackend.wheel.mapper.UserAchievementMapper">

    <select id="selectByUserId" resultType="com.basebackend.wheel.entity.UserAchievement">
        SELECT * FROM user_achievement
        WHERE user_id = #{userId}
        ORDER BY is_unlocked DESC, id ASC
    </select>

    <select id="selectByUserIdAndAchievementId" resultType="com.basebackend.wheel.entity.UserAchievement">
        SELECT * FROM user_achievement
        WHERE user_id = #{userId}
        AND achievement_id = #{achievementId}
        LIMIT 1
    </select>

</mapper>
