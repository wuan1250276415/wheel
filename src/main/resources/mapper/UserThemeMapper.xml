<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basebackend.wheel.mapper.UserThemeMapper">

    <resultMap id="BaseResultMap" type="com.basebackend.wheel.entity.UserTheme">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="user_id" jdbcType="BIGINT" property="userId"/>
        <result column="theme_id" jdbcType="BIGINT" property="themeId"/>
        <result column="is_active" jdbcType="TINYINT" property="isActive"/>
        <result column="purchased_at" jdbcType="TIMESTAMP" property="purchasedAt"/>
        <result column="purchase_type" jdbcType="TINYINT" property="purchaseType"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="create_by" jdbcType="BIGINT" property="createBy"/>
        <result column="update_by" jdbcType="BIGINT" property="updateBy"/>
        <result column="deleted" jdbcType="TINYINT" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, theme_id, is_active, purchased_at, purchase_type,
        create_time, update_time, create_by, update_by, deleted
    </sql>

    <!-- 查询用户拥有的所有主题 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_theme
        WHERE user_id = #{userId}
        ORDER BY purchased_at DESC
    </select>

    <!-- 查询用户当前使用的主题 -->
    <select id="selectActiveTheme" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_theme
        WHERE user_id = #{userId} AND is_active = 1
        LIMIT 1
    </select>

    <!-- 取消用户所有主题的激活状态 -->
    <update id="deactivateAllThemes">
        UPDATE user_theme
        SET is_active = 0, update_time = NOW()
        WHERE user_id = #{userId}
    </update>

    <!-- 检查用户是否拥有某个主题 -->
    <select id="selectByUserIdAndThemeId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_theme
        WHERE user_id = #{userId} AND theme_id = #{themeId}
        LIMIT 1
    </select>

</mapper>
