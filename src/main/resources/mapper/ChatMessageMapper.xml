<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basebackend.wheel.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.basebackend.wheel.entity.ChatMessage">
        <id column="id" property="id"/>
        <result column="couple_id" property="coupleId"/>
        <result column="sender_id" property="senderId"/>
        <result column="receiver_id" property="receiverId"/>
        <result column="message_type" property="messageType"/>
        <result column="content" property="content"/>
        <result column="extra_data" property="extraData"/>
        <result column="is_read" property="isRead"/>
        <result column="read_time" property="readTime"/>
        <result column="recalled_by" property="recalledBy"/>
        <result column="recalled_at" property="recalledAt"/>
        <result column="status" property="status"/>
        <result column="create_by" property="createBy" jdbcType="BIGINT"/>
        <result column="update_by" property="updateBy" jdbcType="BIGINT"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByCoupleId" resultMap="BaseResultMap">
        SELECT *
        FROM chat_message
        WHERE couple_id = #{coupleId}
        AND status != 0
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countUnreadMessages" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM chat_message
        WHERE receiver_id = #{receiverId}
        AND is_read = 0
        AND status = 1
    </select>

    <update id="markAsRead">
        UPDATE chat_message
        SET is_read = 1,
            read_time = NOW()
        WHERE id = #{messageId}
        AND receiver_id = #{receiverId}
        AND status = 1
    </update>

    <update id="batchMarkAsRead">
        UPDATE chat_message
        SET is_read = 1,
            read_time = NOW()
        WHERE receiver_id = #{receiverId}
        AND sender_id = #{senderId}
        AND is_read = 0
        AND status = 1
    </update>

</mapper>
