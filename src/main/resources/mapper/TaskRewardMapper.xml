<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basebackend.wheel.mapper.TaskRewardMapper">

    <select id="selectByUserId" resultType="com.basebackend.wheel.entity.TaskReward">
        SELECT * FROM task_reward
        WHERE user_id = #{userId}
        ORDER BY claimed_at DESC
    </select>

</mapper>
