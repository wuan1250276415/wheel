<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basebackend.wheel.mapper.WheelThemeMapper">

    <resultMap id="BaseResultMap" type="com.basebackend.wheel.entity.WheelTheme">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="theme_name" jdbcType="VARCHAR" property="themeName"/>
        <result column="theme_key" jdbcType="VARCHAR" property="themeKey"/>
        <result column="description" jdbcType="VARCHAR" property="description"/>
        <result column="theme_config" jdbcType="VARCHAR" property="themeConfig"/>
        <result column="preview_url" jdbcType="VARCHAR" property="previewUrl"/>
        <result column="price" jdbcType="INTEGER" property="price"/>
        <result column="is_default" jdbcType="TINYINT" property="isDefault"/>
        <result column="status" jdbcType="TINYINT" property="status"/>
        <result column="sort_order" jdbcType="INTEGER" property="sortOrder"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="create_by" jdbcType="BIGINT" property="createBy"/>
        <result column="update_by" jdbcType="BIGINT" property="updateBy"/>
        <result column="deleted" jdbcType="TINYINT" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, theme_name, theme_key, description, theme_config, preview_url, price,
        is_default, status, sort_order, create_time, update_time, create_by, update_by, deleted
    </sql>

    <!-- 查询所有启用的主题 -->
    <select id="selectEnabledThemes" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM wheel_theme
        WHERE status = 1
        ORDER BY sort_order ASC, id ASC
    </select>

    <!-- 根据主题key查询主题 -->
    <select id="selectByThemeKey" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM wheel_theme
        WHERE theme_key = #{themeKey}
        LIMIT 1
    </select>

    <!-- 查询默认主题 -->
    <select id="selectDefaultTheme" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM wheel_theme
        WHERE is_default = 1 AND status = 1
        LIMIT 1
    </select>

</mapper>
