# 环境配置示例

# 开发环境配置
VITE_APP_TITLE=情侣转盘小程序
VITE_APP_ENV=development

# API 基础地址
VITE_API_BASE_URL=http://192.168.66.126:8280/wheel-api

# WebSocket 地址 (SockJS 会将 ws:// 转换为 http://)
VITE_WS_BASE_URL=ws://192.168.66.118:8180/ws

# 上传文件地址
VITE_UPLOAD_BASE_URL=http://localhost:8280/upload

# 是否开启调试模式
VITE_DEBUG=true

# 日志级别
VITE_LOG_LEVEL=debug

# 地图 API Key（如果使用地图功能）
VITE_MAP_API_KEY=

# 统计分析 ID
VITE_ANALYTICS_ID=
